{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DistroForge",
  "version": "1.1.0",
  "identifier": "com.distroforge.desktop",
  "build": {
    "frontendDist": "../../web-ui/dist",
    "devUrl": "http://127.0.0.1:8080"
  },
  "app": {
    "windows": [
      {
        "title": "DistroForge",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Constructor de distribuciones Linux",
    "longDescription": "DistroForge monta tu propia distribución Linux: eliges base, escritorio, paquetes, repos y sistema, y genera el proyecto de construcción completo (receta del motor, build.sh y workflow de CI) listo para descargar.",
    "copyright": "© 2026 DistroForge",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://8080-agquomtcvruyqlfzbgdq6adiie.instabox.tech/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFENDUyRTQ2QzczMTA4NzQKUldSMENESEhSaTVGcmFsMlZJRTNQaGkzcjdWUzRpWWRrU1NOcWwwVTN2c1BwK3kzbllCME5xZWUK"
    }
  }
}
