{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DistroForge",
  "version": "0.5.0",
  "identifier": "com.distroforge.desktop",
  "build": {
    "frontendDist": "../../web-ui/dist",
    "devUrl": "http://127.0.0.1:8080"
  },
  "app": {
    "windows": [
      {
        "title": "DistroForge",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Constructor de distribuciones Linux",
    "longDescription": "DistroForge monta tu propia distribución Linux: eliges base, escritorio, paquetes, repos y sistema, y genera el proyecto de construcción completo (receta del motor, build.sh y workflow de CI) listo para descargar.",
    "copyright": "© 2026 DistroForge",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
